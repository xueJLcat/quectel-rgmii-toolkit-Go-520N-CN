{
  "name": "simpleadmin-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "SimpleAdmin 前端样式构建（Tailwind CSS v4）。产物输出到 ../www/css/tailwind.css，由 `make css` 驱动。",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "build": "tailwindcss -i input.css -o ../www/css/tailwind.css --minify"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.3.3": true
  }
}
